# Copiá este archivo a .env y completá los valores.
# `npm run server` / `npm start` lo cargan con `node --env-file-if-exists=.env`.

# Obligatoria: secreto para firmar los JWT (usá un valor largo y aleatorio)
JWT_SECRET=change-me-to-a-long-random-string

# Puerto del servidor API
PORT=3001

# Orígenes permitidos por CORS (lista separada por comas, o * para cualquiera)
CORS_ORIGIN=http://localhost:3000

# Interfaz en la que escucha (por defecto todas). Detrás de un proxy inverso: 127.0.0.1
# HOST=127.0.0.1

# Detrás de un proxy inverso (nginx): confiar en X-Forwarded-For para conocer la IP del
# visitante (los límites de intentos son por IP). `loopback` si el proxy está en la misma máquina.
# TRUST_PROXY=loopback

# Ruta de la base SQLite (por defecto server/data/carrigraph.db)
# DB_PATH=./server/data/carrigraph.db

# production: el servidor además sirve dist/ con fallback a index.html
# NODE_ENV=production
