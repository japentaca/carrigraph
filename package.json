{
  "name": "carrigraph",
  "version": "1.0.0",
  "description": "Música generativa con grafos de nodos (Vue 3 + Vue Flow + Web Audio)",
  "license": "MIT",
  "author": "japentaca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/japentaca/carrigraph.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:server": "vitest run --project server",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pinia": "^3.0.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "vue": "^3.5.45",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
